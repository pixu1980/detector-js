{
  "name": "detector-js",
  "version": "3.0.0",
  "description": "DetectorJS, zero-dependency platform/environment detector written in ES6",
  "main": "dist/detector.js",
  "browser": "dist/detector.browser.min.js",
  "module": "dist/detector.mjs",
  "keywords": [
    "detector",
    "detector-js",
    "detection",
    "feature-detection",
    "platform-detection",
    "cpu-detection",
    "gpu-detection",
    "browser-detection",
    "layout-engine-detection",
    "engine-detection",
    "os-detection",
    "useragent-parser",
    "zero-dependency",
    "vanilla",
    "es6",
    "javascript",
    "monorepo",
    "workspaces",
    "webgpu",
    "webauthn",
    "web-share",
    "wake-lock",
    "web-locks",
    "webxr",
    "webapi"
  ],
  "author": "Emiliano 'Pixu' Pisu <pisuemiliano.1980@gmail.com>",
  "contributors": [
    "Emiliano 'Pixu' Pisu <pisuemiliano.1980@gmail.com>"
  ],
  "license": "MIT",
  "scripts": {
    "docs": "rm -rf docs && jsdoc -R ./README.md -r -c ./jsdoc.json && echo 'Documentation built in ./docs folder'",
    "readme": "pkg-2-readme package.json > README.md -t \"./pkg-2-readme.template.md\" && echo 'README.md file built' || echo 'README.md building error'",
    "test": "pnpm -r test && node test/smoke.js",
    "prebuild": "rm -rf dist",
    "build": "pnpm -r build && NODE_ENV=production rollup -c",
    "build:dev": "rollup -c -w",
    "clean": "rm -rf dist packages/*/dist node_modules"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixu1980/detector-js.git"
  },
  "bugs": {
    "url": "https://github.com/pixu1980/detector-js/issues"
  },
  "homepage": "https://github.com/pixu1980/detector-js#readme",
  "documentation": "https://detector.js.org/docs/index.html",
  "todo": "https://github.com/pixu1980/detector-js#todo",
  "files": [
    "dist"
  ],
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@detector-js/core": "workspace:*",
    "@detector-js/detector": "workspace:*",
    "@detector-js/feature": "workspace:*",
    "@detector-js/hardware": "workspace:*",
    "@detector-js/software": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.13.10",
    "@babel/preset-env": "^7.13.10",
    "@rollup/plugin-node-resolve": "^13.3.0",
    "docdash": "^1.2.0",
    "eslint": "^7.21.0",
    "eslint-config-airbnb": "^18.2.1",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-react": "^7.22.0",
    "ink-docstrap": "^1.3.2",
    "install": "^0.13.0",
    "jsdoc": "^3.6.6",
    "jshint": "^2.12.0",
    "rollup": "^2.41.0",
    "rollup-plugin-babel": "^4.4.0",
    "rollup-plugin-eslint": "^7.0.0",
    "rollup-plugin-filesize": "^9.1.1",
    "rollup-plugin-json": "^4.0.0",
    "rollup-plugin-replace": "^2.2.0",
    "rollup-plugin-uglify": "^6.0.4"
  }
}
