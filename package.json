{
  "name": "detector-js",
  "version": "2.0.11",
  "description": "DetectorJS, zero-dependency platform/environment detector written in ES6",
  "main": "dist/detector.js",
  "browser": "dist/detector.browser.min.js",
  "module": "dist/detector.mjs",
  "keywords": [
    "detector",
    "detector-js",
    "detection",
    "feature-detection",
    "platform-detection",
    "cpu-detection",
    "gpu-detection",
    "browser-detection",
    "layout-engine-detection",
    "engine-detection",
    "os-detection",
    "useragent-parser",
    "zero-dependency",
    "vanilla",
    "es6",
    "javascript",
    "monorepo",
    "workspaces",
    "webgpu",
    "webauthn",
    "web-share",
    "wake-lock",
    "web-locks",
    "webxr",
    "webapi"
  ],
  "author": "Emiliano 'Pixu' Pisu <pisuemiliano.1980@gmail.com>",
  "contributors": [
    "Emiliano 'Pixu' Pisu <pisuemiliano.1980@gmail.com>"
  ],
  "license": "MIT",
  "scripts": {
    "docs": "rm -rf docs && jsdoc -R ./README.md -r -c ./jsdoc.json && echo 'Documentation built in ./docs folder'",
    "readme": "node scripts/build-readme.mjs",
    "lint": "eslint packages test browser scripts examples playwright.config.mjs index.d.ts",
    "test": "node scripts/test.mjs",
    "prebuild": "rm -rf dist packages/*/dist",
    "build": "node scripts/build.mjs && node scripts/build-dts.mjs && node scripts/build-docs.mjs",
    "build:dev": "node scripts/build.mjs --watch",
    "serve": "node scripts/serve.mjs",
    "clean": "rm -rf dist packages/*/dist node_modules",
    "build:site": "node scripts/build-docs.mjs",
    "release": "node scripts/release.mjs",
    "release:dryrun": "node scripts/release.mjs --dry-run",
    "release:publish": "node scripts/release.mjs --publish",
    "check:size": "node scripts/check-size.mjs",
    "test:coverage": "node scripts/test-coverage.mjs",
    "sri": "node scripts/sri.mjs",
    "types:check": "tsc -p tsconfig.types.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixu1980/detector-js.git"
  },
  "bugs": {
    "url": "https://github.com/pixu1980/detector-js/issues"
  },
  "homepage": "https://github.com/pixu1980/detector-js#readme",
  "documentation": "https://detector.js.org/docs/index.html",
  "todo": "https://github.com/pixu1980/detector-js#todo",
  "files": [
    "dist"
  ],
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@detector-js/core": "workspace:*",
    "@detector-js/detector": "workspace:*",
    "@detector-js/feature": "workspace:*",
    "@detector-js/hardware": "workspace:*",
    "@detector-js/software": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "docdash": "^1.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^7.21.0",
    "eslint-config-airbnb": "^18.2.1",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-react": "^7.22.0",
    "ink-docstrap": "^1.3.2",
    "install": "^0.13.0",
    "jsdoc": "^3.6.6",
    "jshint": "^2.12.0",
    "marked": "^18.0.11",
    "typescript": "^7.0.2"
  },
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/detector.mjs",
      "require": "./dist/detector.js",
      "default": "./dist/detector.js"
    },
    "./browser": "./dist/detector.browser.min.js",
    "./package.json": "./package.json"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=14"
  },
  "publishConfig": {
    "access": "public"
  },
  "unpkg": "dist/detector.browser.min.js",
  "jsdelivr": "dist/detector.browser.min.js"
}
