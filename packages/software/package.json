{
  "name": "@detector-js/software",
  "version": "3.0.0",
  "description": "DetectorJS Software Module",
  "keywords": [
    "detector-js",
    "software",
    "browser",
    "engine",
    "os"
  ],
  "author": "Emiliano 'Pixu' Pisu <pisuemiliano.1980@gmail.com>",
  "contributors": [
    "Emiliano 'Pixu' Pisu <pisuemiliano.1980@gmail.com>"
  ],
  "homepage": "",
  "license": "MIT",
  "source": "lib/software.js",
  "main": "dist/software.js",
  "module": "dist/software.mjs",
  "targets": {
    "main": {
      "optimize": true
    },
    "module": {
      "optimize": true
    }
  },
  "scripts": {
    "test": "node --test ./__tests__/software.test.js",
    "build": "node ../../scripts/build-package.mjs",
    "watch": "node ../../scripts/build-package.mjs --watch"
  },
  "directories": {
    "dist": "dist",
    "lib": "lib",
    "test": "__tests__"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@detector-js/core": "workspace:*"
  },
  "types": "./lib/software.d.ts",
  "exports": {
    ".": {
      "types": "./lib/software.d.ts",
      "import": "./dist/software.mjs",
      "require": "./dist/software.js",
      "default": "./dist/software.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=14"
  },
  "publishConfig": {
    "access": "public"
  }
}
